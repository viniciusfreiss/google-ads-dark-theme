{
  "manifest_version": 3,
  "name": "Google Ads Dark Theme",
  "version": "1.2",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ads.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ads.google.com/*"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  }
}